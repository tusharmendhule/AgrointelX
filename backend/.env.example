# =============================================================================
# AgroIntelX Backend Configuration
# =============================================================================

# Port the API server listens on
PORT=3001

# Comma-separated list of allowed frontend origins for CORS.
# Use "*" to allow any origin (not recommended in production).
APP_URL=http://localhost:5173

# MongoDB Atlas (or any MongoDB) connection string.
# If omitted, the server falls back to local JSON file storage in ./data/db.json
MONGODB_URI=YOUR_MONGODB_CONNECTION_STRING

# Google Gemini API key. If omitted, AI endpoints run in offline simulation mode.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# =============================================================================
# Weather & Location APIs (All FREE - No API keys required!)
# =============================================================================
# AgroIntelX uses these free, no-auth-required APIs:
#
# 1. Open-Meteo Weather API (https://open-meteo.com)
#    - Current weather, 7-day forecast, UV index, pressure, visibility
#    - No API key needed
#
# 2. OpenStreetMap Nominatim (https://nominatim.openstreetmap.org)
#    - Reverse geocoding (coordinates → address)
#    - No API key needed
#
# 3. Open-Meteo Geocoding (https://open-meteo.com/en/docs/geocoding-api)
#    - Forward geocoding (address → coordinates)
#    - No API key needed
#
# Weather data is cached in-memory for 10 minutes to reduce API calls.
# All weather requests go through the backend (never expose API calls from frontend).
